# DevOps Orchestrator — environment variables
# Copy to .env and fill in values before running.

# =============================================================================
# LLM Relay (internal custom provider)
# =============================================================================
LLM_RELAY_BASE_URL=http://llm-relay.example.internal/v1
LLM_RELAY_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx

# =============================================================================
# Feishu Bot credentials
# =============================================================================
# Requirements: The Feishu app MUST have "Bot" capability enabled in the
# developer console (Features > Bot). Verify with:
#   curl -s https://open.feishu.cn/open-apis/bot/v3/info \
#     -H "Authorization: Bearer <tenant_access_token>"
# If response is {"code":11205,"msg":"app do not have bot"}, enable bot first.

FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Bot display name — set this to avoid needing admin:app.info:readonly scope.
# Value must match the bot name shown in the Feishu developer console.
FEISHU_BOT_NAME=你的机器人名称

# =============================================================================
# Gateway access policy
# =============================================================================
# GATEWAY_ALLOW_ALL_USERS controls who can interact with the bot.
# This setting is read from ~/.hermes/.env (global), NOT from the profile .env.
# To allow all users: set GATEWAY_ALLOW_ALL_USERS=true in ~/.hermes/.env
# To restrict: set FEISHU_ALLOWED_USERS below (profile .env is effective here).

# Comma-separated Feishu open_ids (optional — restricts access to listed users)
# FEISHU_ALLOWED_USERS=ou_xxxxxxxx,ou_yyyyyyyy

# Default Feishu chat_id for outbound notifications (optional)
# FEISHU_HOME_CHANNEL=oc_xxxxxxxxxxxxxxxx

# ── Dashboard Files 面板根目录 ────────────────────────────────────
# Hermes dashboard 的 Files 面板默认 fallback 到家目录(~)，而非 workspace。
# 设置本变量可将其锁定到当前 profile 目录(锁定后无法上翻，can_change_path=false)。
# 由 hermes_cli/web_server.py 的 _managed_files_policy() 读取，支持 ~ 展开。
HERMES_DASHBOARD_FILES_ROOT=~/.hermes/profiles/orchestrator
