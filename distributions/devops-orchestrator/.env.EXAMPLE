# DevOps Orchestrator — required environment variables
# Copy to .env and fill in values before running.

# Feishu Bot credentials (required)
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Allowed Feishu user open_ids (comma-separated, optional — omit to allow all users in permitted groups)
FEISHU_ALLOWED_USERS=ou_xxxxxxxx,ou_yyyyyyyy

# Default Feishu chat_id for result notifications (optional — falls back to originating chat)
FEISHU_HOME_CHANNEL=oc_xxxxxxxxxxxxxxxx
