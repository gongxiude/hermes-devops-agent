# Alibaba Cloud credentials (required)
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_REGION=cn-hangzhou

# Kubernetes cluster access (optional)
KUBECONFIG_READONLY=
K8S_CONTEXT=
KUBECTL_BIN=kubectl

# Internal LLM relay
LLM_RELAY_BASE_URL=
LLM_RELAY_API_KEY=
# ── Dashboard Files 面板根目录 ────────────────────────────────────
# Hermes dashboard 的 Files 面板默认 fallback 到家目录(~)，而非 workspace。
# 设置本变量可将其锁定到当前 profile 目录(锁定后无法上翻，can_change_path=false)。
# 由 hermes_cli/web_server.py 的 _managed_files_policy() 读取，支持 ~ 展开。
HERMES_DASHBOARD_FILES_ROOT=~/.hermes/profiles/infra-agent
