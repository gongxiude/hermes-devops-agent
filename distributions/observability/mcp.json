{
  "mcpServers": {
    "loki-intlsms-prod": {
      "transport": "stdio",
      "command": "/opt/hermes/.venv/bin/python",
      "args": [
        "/opt/mcp-servers/loki/src/server.py"
      ],
      "env": {
        "MCP_SERVER_NAME": "loki-intlsms-prod",
        "LOKI_URL": "${OBSERVE_LOKI_BASE_URL_PROD}",
        "LOKI_TOKEN": "${OBSERVE_LOKI_TOKEN_PROD}",
        "MCP_LOG_LEVEL": "INFO"
      },
      "tools": {
        "include": [
          "loki_backend_health",
          "loki_query_range",
          "loki_labels",
          "loki_label_values",
          "loki_series"
        ]
      }
    }
  }
}
