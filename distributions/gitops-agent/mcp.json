{
  "mcpServers": {
    "git-codeup": {
      "transport": "stdio",
      "command": "/opt/hermes/.venv/bin/python",
      "args": [
        "/opt/mcp-servers/git-codeup/src/server.py"
      ],
      "env": {
        "MCP_SERVER_NAME": "git-codeup",
        "CODEUP_BASE_URL": "${CODEUP_BASE_URL}",
        "CODEUP_ACCESS_TOKEN": "${CODEUP_ACCESS_TOKEN}",
        "CODEUP_ORGANIZATION_ID": "${CODEUP_ORGANIZATION_ID}",
        "LOCAL_GIT_ROOT": "${SOFTWARE_DELIVERY_WORKSPACE_ROOT}",
        "MCP_LOG_LEVEL": "INFO"
      },
      "tools": {
        "include": [
          "codeup_list_repositories",
          "codeup_list_change_requests",
          "codeup_get_change_request",
          "codeup_list_commits",
          "git_repo_status",
          "codeup_create_change_request"
        ]
      }
    },
    "jenkins": {
      "transport": "streamable_http",
      "sampling": {
        "enabled": false
      },
      "elicitation": {
        "enabled": false
      },
      "url": "${JENKINS_MCP_URL}",
      "headers": {
        "Authorization": "${JENKINS_MCP_AUTHORIZATION}"
      },
      "tools": {
        "include": [
          "whoAmI",
          "getStatus",
          "getJobs",
          "findJobsWithScmUrl",
          "getJob",
          "getJobScm",
          "getBuild",
          "getBuildScm",
          "getBuildChangeSets",
          "getBuildLog",
          "searchBuildLog",
          "getQueueItem",
          "getTestResults",
          "getFlakyFailures"
        ]
      }
    }
  }
}
