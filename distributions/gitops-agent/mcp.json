{
  "mcpServers": {
    "git-codeup": {
      "transport": "stdio",
      "command": "python3",
      "args": [
        "/Users/gongxiude/Documents/yuexin/hermes-devops-agent/mcp-servers/git-codeup/src/server.py"
      ],
      "env": {
        "MCP_SERVER_NAME": "git-codeup",
        "CODEUP_BASE_URL": "${CODEUP_BASE_URL}",
        "CODEUP_ACCESS_TOKEN": "${CODEUP_ACCESS_TOKEN}",
        "CODEUP_ORGANIZATION_ID": "${CODEUP_ORGANIZATION_ID}",
        "LOCAL_GIT_ROOT": "${SOFTWARE_DELIVERY_WORKSPACE_ROOT}",
        "MCP_LOG_LEVEL": "INFO"
      },
      "tools": {
        "include": [
          "codeup_list_repositories",
          "codeup_list_change_requests",
          "codeup_get_change_request",
          "codeup_list_commits",
          "git_repo_status",
          "codeup_create_change_request"
        ]
      }
    },
    "argocd": {
      "transport": "stdio",
      "command": "python3",
      "args": [
        "/Users/gongxiude/Documents/yuexin/hermes-devops-agent/mcp-servers/argocd/src/server.py"
      ],
      "env": {
        "MCP_SERVER_NAME": "argocd",
        "ARGOCD_SERVER": "${ARGOCD_SERVER}",
        "ARGOCD_TOKEN": "${ARGOCD_TOKEN}",
        "MCP_LOG_LEVEL": "INFO"
      },
      "tools": {
        "include": [
          "argocd_get_version",
          "argocd_list_applications",
          "argocd_get_application",
          "argocd_get_recent_syncs"
        ]
      }
    }
  }
}
