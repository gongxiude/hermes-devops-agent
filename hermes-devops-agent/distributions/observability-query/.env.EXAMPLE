# Feishu gateway credentials live in the installed profile .env.
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=secret_xxx
FEISHU_DOMAIN=feishu
FEISHU_CONNECTION_MODE=websocket
FEISHU_ALLOWED_USERS=ou_sre_1,ou_service_owner_1
FEISHU_REQUIRE_MENTION=true

# Read-only observability endpoints, selected by environment.
OBSERVE_PROMETHEUS_BASE_URL_PROD=https://prometheus-prod.example.internal
OBSERVE_LOKI_BASE_URL_PROD=https://loki-prod.example.internal
OBSERVE_PROMETHEUS_BASE_URL_TEST=https://prometheus-test.example.internal
OBSERVE_LOKI_BASE_URL_TEST=https://loki-test.example.internal

# Read-only Kubernetes access, selected by environment.
KUBECONFIG_READONLY_PROD=/secure/path/prod-aliyun-sg-intlsms-readonly.kubeconfig
KUBECTL_BIN_PROD=kubectl
KUBECONFIG_READONLY_TEST=/secure/path/test-aliyun-zjk-intlsms-readonly.kubeconfig
KUBECTL_BIN_TEST=kubectl

# Optional secret broker / vault references.
DEVOPS_POLICY_ENDPOINT=https://policy.example.internal
DEVOPS_AUDIT_ENDPOINT=https://audit.example.internal


