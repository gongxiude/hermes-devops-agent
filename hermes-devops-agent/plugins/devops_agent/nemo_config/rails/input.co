# DevOps Agent — Input Rail Flows (Colang 1.0)
# =============================================
# These flows run BEFORE the main LLM is called.
# They use dialog matching (zero-LLM-cost) to reject off-topic requests.
# Jailbreak heuristics are handled by config.yml jailbreak_detection block.

# ---------------------------------------------------------------------------
# Off-topic patterns (non-DevOps requests)
# ---------------------------------------------------------------------------

define user ask off topic
  "what's the weather today?"
  "tell me a joke"
  "write me a poem"
  "who won the game last night?"
  "recommend a movie"
  "help me write an email"
  "translate this text"
  "what is 2+2"

define bot refuse off topic
  "I'm a DevOps assistant. I can only help with infrastructure, Kubernetes, monitoring, deployments, and related operations topics."

define flow check devops off topic
  user ask off topic
  bot refuse off topic
  stop

# ---------------------------------------------------------------------------
# Jailbreak heuristics is provided by NeMo's built-in flow
# 'jailbreak detection heuristics' (referenced in config.yml).
# Thresholds are configured under rails.config.jailbreak_detection.
# ---------------------------------------------------------------------------
